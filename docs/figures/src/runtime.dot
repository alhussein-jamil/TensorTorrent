digraph Runtime {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.28", ranksep="0.55", splines=ortho, fontname="Inter"];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=11, margin="0.16,0.11", color="#CBD5E1", penwidth=1.1, fillcolor="#FFFFFF", fontcolor="#0F172A"];
  edge [color="#64748B", penwidth=1.35, arrowsize=0.7];

  request [label="forward() request", fillcolor="#F8FAFC"];
  dispatcher [label="Schedule dispatcher\nRust", fillcolor="#FEF2F2", color="#FCA5A5"];
  context [label="ExecutionContext\nrequest-scoped state", fillcolor="#FEF2F2", color="#FCA5A5"];
  residency [label="Residency & leases\nRust authority", fillcolor="#FFF7ED", color="#FDBA74"];
  io [label="Pack / spill I/O\ntt-storage", fillcolor="#F0FDF4", color="#86EFAC"];
  workers [label="Compute workers\nCPU / accelerator", fillcolor="#EFF6FF", color="#93C5FD"];
  callback [label="Torch region callback\nPython when required", fillcolor="#F8FAFC", color="#CBD5E1"];
  telemetry [label="Events · counters · traces", fillcolor="#FAF5FF", color="#D8B4FE"];
  output [label="output tensors", fillcolor="#F8FAFC"];

  request -> dispatcher -> context;
  context -> residency;
  context -> io;
  context -> workers;
  workers -> callback [style=dashed, label="torch regions", fontsize=9, fontname="Inter"];
  callback -> workers [style=dashed];
  residency -> workers [label="ready copies", fontsize=9, fontname="Inter"];
  io -> residency [label="load / evict", fontsize=9, fontname="Inter"];
  workers -> telemetry;
  residency -> telemetry;
  io -> telemetry;
  workers -> output;
}
