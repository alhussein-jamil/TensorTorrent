# syntax=docker/dockerfile:1.7
# GPU / CUDA production image for TensorTorrent.
#
# This image mirrors the structure and hardening of the validated CPU Dockerfile
# (non-root UID 10001, HEALTHCHECK /health, STOPSIGNAL SIGTERM,
# read-only-friendly layout).
#
# The image is build-validated in CI. A real GPU smoke test is still required on
# a host with an NVIDIA driver and nvidia-container-toolkit before production use.
#
# BUILD
# ─────
#   docker build -f Dockerfile.cuda -t tensortorrent:cuda .
#
# RUN (requires nvidia-container-toolkit on the host)
# ────
#   docker run --gpus all \
#     --env TT_SERVE_AUTH_TOKEN="$(cat /run/secrets/tt_token)" \
#     --env TT_LOG_FORMAT=json \
#     -v /path/to/models:/models:ro \
#     -p 127.0.0.1:8080:8080 \
#     tensortorrent:cuda
#
# SMOKE TEST on GPU host (run before promoting to production)
# ────────────────────────────────────────────────────────────
#   docker run --rm --gpus all tensortorrent:cuda \
#     python -c "from tensortorrent.native import require_native; require_native(); print('native OK')"
#   docker run --rm --gpus all tensortorrent:cuda \
#     sh -c 'test "$(id -u)" -ne 0 && echo "non-root OK"'
#   docker run --rm --gpus all tensortorrent:cuda \
#     python -c "import torch; assert torch.cuda.is_available(), 'No CUDA'; print('CUDA OK')"

# ── Build-time ARGs ──────────────────────────────────────────────────────────
ARG CUDA_IMAGE=nvidia/cuda:13.0.2-runtime-ubuntu22.04@sha256:f6e92fc2e0db221671325ff1a0e8725422de63b85d777f8aa8efc1858309ab53
ARG UV_VERSION=0.11.21
ARG MATURIN_VERSION=1.14.1
ARG RUST_VERSION=1.85.1
ARG PYTHON_VERSION=3.10

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-bin

# ── Rust / wheel-builder stage ───────────────────────────────────────────────
# Build on the same Ubuntu/CUDA base and the same CPython minor as runtime.
# This deliberately avoids producing a cp311 wheel and then trying to install it
# into the Ubuntu 22.04 CPython 3.10 runtime.
FROM ${CUDA_IMAGE} AS wheel-builder
ARG MATURIN_VERSION
ARG RUST_VERSION
ARG PYTHON_VERSION
COPY --from=uv-bin /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        python3.10-dev \
        python3.10-venv \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /build
COPY Cargo.toml Cargo.lock pyproject.toml README.md LICENSE ./
COPY crates ./crates
COPY python ./python
RUN uv venv --python python3.10 /opt/build-venv \
    && uv pip install --python /opt/build-venv/bin/python "maturin==${MATURIN_VERSION}" \
    && PYO3_PYTHON=/opt/build-venv/bin/python /opt/build-venv/bin/maturin build \
        --release --locked --interpreter /opt/build-venv/bin/python --out /dist

# ── CUDA runtime stage ───────────────────────────────────────────────────────
FROM ${CUDA_IMAGE} AS runtime
ARG PYTHON_VERSION
# Torch 2.13 CUDA wheels are published on the cu130 index.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG TORCH_VERSION=2.13.0
ARG SERVICE_UID=10001
ARG SERVICE_GID=10001

COPY --from=uv-bin /uv /usr/local/bin/uv

# Ubuntu 22.04 ships Python 3.10 natively. Keep runtime Python identical to the
# wheel-builder interpreter so the native wheel ABI is guaranteed to match.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        python3-pip \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${SERVICE_GID}" tensortorrent \
    && useradd --uid "${SERVICE_UID}" --gid "${SERVICE_GID}" --create-home tensortorrent

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1

COPY --from=wheel-builder /dist /tmp/wheels
# Large CUDA torch wheels pull from pypi.nvidia.com; default UV timeout is too
# aggressive on flaky CI/network links and aborts mid-download.
ENV UV_HTTP_TIMEOUT=600
RUN uv pip install --system --no-cache --index-url "${TORCH_INDEX_URL}" "torch==${TORCH_VERSION}" \
    && uv pip install --system --no-cache /tmp/wheels/*.whl \
    && rm -rf /tmp/wheels /root/.cache /usr/local/bin/uv

# ── Environment ──────────────────────────────────────────────────────────────
# TT_SERVE_AUTH_TOKEN: pass a secret token via --env or a secrets manager.
# Leave unset only for explicitly unauthenticated deployments.
ENV HOME=/home/tensortorrent \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TT_LOG_FORMAT=json

USER tensortorrent:tensortorrent
WORKDIR /home/tensortorrent
VOLUME ["/models"]
EXPOSE 8080
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2).read()"]

CMD ["tensortorrent-serve", "--listen", "0.0.0.0:8080", "--artifact", "/models/model", "--model-id", "default"]
